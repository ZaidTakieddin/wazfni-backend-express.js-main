# Example Environment Variables

# Server Configuration
PORT=3000

# Database Configuration (REQUIRED)
# Make sure the user, password, host, port, and database name are placeholders
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT Configuration (REQUIRED for authentication)
# JWT_SECRET=your_super_secret_key
# JWT_EXPIRES_IN=1d 

# Google OAuth Configuration for React Native (OPTIONAL)
# Get your Google Client ID from Google Cloud Console
# This should be the same client ID used in your React Native app
GOOGLE_CLIENT_ID=636000833085-m4sc8bk5pgdjificaar3oeag70jrifhb.apps.googleusercontent.com
# Note: CLIENT_SECRET and CALLBACK_URL not needed for React Native token verification
# GOOGLE_CLIENT_SECRET=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  
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Firebase Configuration for Push Notifications (OPTIONAL)
# If these are not provided, Firebase notifications will be disabled but the app will still work
# Get these from your Firebase project settings -> Service accounts
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Note: The app will start without Firebase variables and simply disable push notifications
