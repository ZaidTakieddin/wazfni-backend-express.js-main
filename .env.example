# Example Environment Variables

# Server Configuration
PORT=3000

# Database Configuration (Update with your actual connection string format)
# Make sure the user, password, host, port, and database name are placeholders
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT Configuration (Example - replace with secure secrets)
# JWT_SECRET=your_super_secret_key
# JWT_EXPIRES_IN=1d 

# Google OAuth Configuration for React Native
# Get your Google Client ID from Google Cloud Console
# This should be the same client ID used in your React Native app
GOOGLE_CLIENT_ID=636000833085-m4sc8bk5pgdjificaar3oeag70jrifhb.apps.googleusercontent.com
# Note: CLIENT_SECRET and CALLBACK_URL not needed for React Native token verification
# GOOGLE_CLIENT_SECRET=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  
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
