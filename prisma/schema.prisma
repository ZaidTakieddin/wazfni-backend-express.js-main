// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "./src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum WorkType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  OTHER
}

enum ContractType {
  REMOTE
  HYBRID
  ON_SITE
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
  EXPERT
}

enum Currency {
  USD
  EUR
  EGP
  // Add more as needed
}

enum ApplicationStatus {
  PENDING
  REJECTED
  ACCEPTED
}

enum SalaryType {
  FIXED
  RANGE
  NONE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String? // Make password optional for Google-only users
  role         Role      @default(USER)
  isVerified   Boolean   @default(false)
  lastLogin    DateTime?
  firstName    String?
  lastName     String?
  phoneNumber  String?
  googleId     String?   @unique // Add this field

  // Firebase Cloud Messaging tokens for push notifications
  fcmTokens String[] // Array to support multiple devices

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications        Application[] // User's applications
  profile             UserProfile?
  company             Company?
  bookmarks           Bookmark[] // Add bookmarks relation
  categoryClicks      CategoryClick[] // Many-to-many relation with categories
  jobViewHistory      JobViewHistory[] // Many-to-many relation with jobs
  passwordResetTokens PasswordResetToken[] // Password reset tokens
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique // Foreign key relation to User
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName            String?
  lastName             String?
  jobTitle             String?
  educationCertificate String?
  cv                   String? // Path or identifier to the stored CV file
  avatar               String? // Path or identifier to the stored avatar file
  phone                String?
  city                 String?
  address              String?
  birthDate            DateTime?
  gender               Gender?

  // New relations
  workExperiences       WorkExperience[]
  educationCertificates EducationCertificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id     String @id @default(cuid())
  userId String @unique // Foreign key relation to User
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  logo                String? // Path or identifier to the stored logo file
  name                String?
  workField           String?
  description         String?
  location            String? // Or consider separate fields like address, city, country
  size                String? // Consider enum or number range
  website             String? // Add URL validation if needed
  city                String?
  commercial_register String?
  tax_number          String?

  // Approval system fields
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedAt      DateTime?
  approvedBy      String? // Admin user ID who approved/rejected
  rejectionReason String? // Reason for rejection
  reviewedAt      DateTime? // When the admin reviewed the company

  jobs Job[] // Relation to jobs (one-to-many)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  icon          String?
  subCategories SubCategory[] // One-to-many relation with subcategories

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubCategory {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  jobs   Job[]           @relation("JobSubCategories") // Relation to jobs (many-to-many)
  clicks CategoryClick[] // Many-to-many relation with users

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, categoryId]) // Ensure unique subcategory names within a category
  @@index([categoryId])
}

model Job {
  id        String  @id @default(cuid())
  companyId String // Foreign key relation to Company
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobTitle        String
  subCategories   SubCategory[]   @relation("JobSubCategories")
  workType        WorkType
  contractType    ContractType
  experienceLevel ExperienceLevel
  experienceYears Int?
  minSalary       Int?
  maxSalary       Int?
  currency        Currency?
  jobFeatures     String[]
  description     String
  requirements    String
  questions       String[]
  isArchived      Boolean         @default(false) // Add archive field
  salaryType      SalaryType      @default(NONE)

  // Approval system fields
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedAt      DateTime?
  approvedBy      String? // Admin user ID who approved/rejected
  rejectionReason String? // Reason for rejection
  reviewedAt      DateTime? // When the admin reviewed the job

  applications Application[] // Applications received for this job
  bookmarks    Bookmark[] // Add bookmarks relation
  viewHistory  JobViewHistory[] // Many-to-many relation with users

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// New model for Work Experience
model WorkExperience {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  jobTitle    String
  companyName String
  startDate   DateTime // Store as DateTime, format as YYYY-MM in application layer
  endDate     DateTime? // Nullable if current job
  description String? // Nullable
  current     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userProfileId]) // Add index for performance
}

// New model for Education/Certificates
model EducationCertificate {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  degree          String
  university      String
  certificateName String? // Optional field for specific certificate name
  startDate       DateTime // Store as DateTime, format as YYYY-MM in application layer
  endDate         DateTime? // Nullable if ongoing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userProfileId]) // Add index for performance
}

// Add this new model
model Application {
  id          String @id @default(cuid())
  jobId       String
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade) // Link to Job
  applicantId String
  applicant   User   @relation(fields: [applicantId], references: [id], onDelete: Cascade) // Link to User (applicant)

  answers String[] // Array of answers corresponding to job questions
  cvPath  String // Relative path to the CV used for this application
  status  ApplicationStatus @default(PENDING) // e.g., PENDING, REVIEWED, REJECTED, HIRED

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, applicantId]) // Ensure a user applies only once per job
  @@index([jobId])
  @@index([applicantId])
}

// Add this new model for bookmarks
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId]) // Ensure a user can only bookmark a job once
  @@index([userId])
  @@index([jobId])
}

// Modified model for tracking category clicks with many-to-many relation
model CategoryClick {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  clickedAt     DateTime    @default(now())
  clickCount    Int         @default(1) // Track number of clicks
  lastClickedAt DateTime    @default(now()) // Track last click time

  @@unique([userId, subCategoryId]) // Ensure one record per user-subcategory pair
  @@index([userId])
  @@index([subCategoryId])
  @@index([lastClickedAt]) // Index for sorting by last click
}

// Modified model for tracking job views with many-to-many relation
model JobViewHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  viewedAt     DateTime @default(now())
  viewCount    Int      @default(1) // Track number of views
  lastViewedAt DateTime @default(now()) // Track last view time

  @@unique([userId, jobId]) // Ensure one record per user-job pair
  @@index([userId])
  @@index([jobId])
  @@index([lastViewedAt]) // Index for sorting by last view
}

// Password reset token model for forgot password functionality
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}
